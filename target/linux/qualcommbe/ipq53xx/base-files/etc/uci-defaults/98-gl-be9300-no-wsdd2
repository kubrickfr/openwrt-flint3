#!/bin/sh
# wsdd2 (WS-Discovery) is pulled in unconditionally by ksmbd-tools ("select PACKAGE_wsdd2"),
# so it cannot be left out of the image. Keep it from running: on 2026-09-28 it was the
# process closing the netlink socket in a kernel panic (netlink socket lifetime bug, open),
# and an access point gains nothing from Windows network browsing of the share, which
# stays reachable by name or address. Re-enable with `/etc/init.d/wsdd2 enable` once the
# kernel bug is fixed. Runs again after every sysupgrade, so the choice survives upgrades.
[ -x /etc/init.d/wsdd2 ] || exit 0
/etc/init.d/wsdd2 disable
/etc/init.d/wsdd2 stop 2>/dev/null
exit 0
